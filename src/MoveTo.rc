/////////////////////////////////////////////////////////////////////////////
//
// REGISTRY
//

IDR_MOVETOSHLEXT        REGISTRY DISCARDABLE    "MoveToShlExt.rgs"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//
// DIALOGEX + "Segoe UI" 9.  Neither "MS Shell Dlg" nor "MS Shell Dlg 2"
// resolves to the shell font on Windows 11 (they map to Microsoft Sans
// Serif and Tahoma via HKLM FontSubstitutes), so the face is named
// outright -- and as a TrueType face it scales cleanly under Explorer's
// per-monitor DPI context.
//

IDD_MANAGE_DESTINATIONS DIALOGEX 0, 0, 360, 232
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "MoveTo - manage destinations"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Folders offered on the ""Move to"" menu. Pinned folders stay at the top and are never dropped automatically.",
                    IDC_DEST_HINT,7,7,346,18
    CONTROL         "",IDC_DEST_LIST,"SysListView32",LVS_REPORT |
                    LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER |
                    WS_GROUP | WS_TABSTOP,7,29,282,160
    PUSHBUTTON      "&Pin",IDC_DEST_PIN,295,29,58,14,WS_GROUP
    PUSHBUTTON      "&Unpin",IDC_DEST_UNPIN,295,47,58,14
    PUSHBUTTON      "Move &up",IDC_MOVE_UP,295,69,58,14
    PUSHBUTTON      "Move &down",IDC_MOVE_DOWN,295,87,58,14
    PUSHBUTTON      "Re&name...",IDC_RENAME,295,109,58,14
    PUSHBUTTON      "&Forget",IDC_FORGET,295,131,58,14
    LTEXT           "&Remember this many recent folders:",IDC_STATIC,7,196,130,8
    EDITTEXT        IDC_CAPACITY,140,194,32,14,ES_AUTOHSCROLL | ES_NUMBER | WS_GROUP
    DEFPUSHBUTTON   "Close",IDOK,303,211,50,14,WS_GROUP
END


