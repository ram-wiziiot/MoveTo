/////////////////////////////////////////////////////////////////////////////
//
// String Table
//

STRINGTABLE DISCARDABLE
BEGIN
    IDS_PROJNAME            "MoveTo"
END

// DO NOT MERGE THIS BLOCK INTO THE ONE ABOVE, RENAME IT, OR RENUMBER IT.
//
// MFC builds CWinApp::m_pszAppName from AFX_IDS_APP_TITLE, and
// m_pszProfileName is copied from it.  MoveTo.cpp calls
// SetRegistryKey(_T("Wiziiot")), and MoveDest.cpp composes the store's
// key path from m_pszRegistryKey and m_pszProfileName:
//
//      HKCU\Software\Wiziiot\MoveTo\Destinations
//
// Without this string MFC falls back to the module's base name, so it
// works only by luck as long as the DLL is called MoveTo.dll.  Rename or
// rebrand the binary and every stored destination silently relocates --
// the user's entire history disappears with no error.
STRINGTABLE DISCARDABLE
BEGIN
    AFX_IDS_APP_TITLE       "MoveTo"
END

